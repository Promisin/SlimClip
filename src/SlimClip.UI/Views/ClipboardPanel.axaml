<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="clr-namespace:SlimClip.UI.ViewModels;assembly=SlimClip.UI"
        xmlns:models="clr-namespace:SlimClip.Core.Models;assembly=SlimClip.Core"
        xmlns:controls="clr-namespace:SlimClip.UI.Controls;assembly=SlimClip.UI"
        xmlns:conv="clr-namespace:SlimClip.UI.Converters;assembly=SlimClip.UI"
        x:Class="SlimClip.UI.Views.ClipboardPanel"
        x:DataType="vm:MainViewModel"
        Title="SlimClip"
        Width="420"
        Height="560"
        MinWidth="340"
        MinHeight="400"
        MaxWidth="800"
        MaxHeight="1200"
        CanResize="True"
        ShowInTaskbar="False"
        Topmost="True"
        ExtendClientAreaToDecorationsHint="True"
        ExtendClientAreaChromeHints="NoChrome"
        ExtendClientAreaTitleBarHeightHint="-1"
        TransparencyLevelHint="AcrylicBlur,Blur,Transparent"
        Background="Transparent"
        Foreground="{DynamicResource TextPrimaryBrush}"
        FontFamily="{DynamicResource PrimaryFontFamily}"
        FontWeight="{DynamicResource NormalFontWeight}"
        UseLayoutRounding="True">

    <Window.Resources>
        <conv:ClipboardTypeToVisibilityConverter x:Key="ClipboardTypeToVisibilityConverter" />
        <conv:ImagePathToBitmapConverter x:Key="ImagePathToBitmapConverter" />
        <conv:HexColorToBrushConverter x:Key="HexColorToBrushConverter" />
        <conv:HexColorVisibilityConverter x:Key="HexColorVisibilityConverter" />
    </Window.Resources>

    <Window.Styles>
        <Style Selector="TextBlock">
            <Setter Property="FontWeight" Value="{DynamicResource NormalFontWeight}" />
        </Style>
        <Style Selector="ListBoxItem">
            <Setter Property="FocusAdorner" Value="{x:Null}" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="Margin" Value="{DynamicResource ItemCardMargin}" />
            <Setter Property="Background" Value="{DynamicResource CardBackground}" />
            <Setter Property="BorderBrush" Value="{DynamicResource CardBorderBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="{DynamicResource ItemCardCornerRadius}" />
            <Setter Property="ClipToBounds" Value="True" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="VerticalContentAlignment" Value="Stretch" />
            <Setter Property="Template">
                <ControlTemplate TargetType="ListBoxItem">
                    <Border Name="ItemBorder"
                            Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            CornerRadius="{TemplateBinding CornerRadius}"
                            ClipToBounds="True"
                            Padding="{TemplateBinding Padding}">
                        <ContentPresenter Name="ItemContentPresenter"
                                          Content="{TemplateBinding Content}"
                                          ContentTemplate="{TemplateBinding ContentTemplate}"
                                          CornerRadius="{TemplateBinding CornerRadius}"
                                          Background="Transparent"
                                          ClipToBounds="True"
                                          HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                          VerticalAlignment="{TemplateBinding VerticalContentAlignment}" />
                    </Border>
                </ControlTemplate>
            </Setter>
        </Style>
        <Style Selector="ListBoxItem /template/ ContentPresenter">
            <Setter Property="CornerRadius" Value="{DynamicResource ItemCardCornerRadius}" />
            <Setter Property="Background" Value="Transparent" />
        </Style>
        <Style Selector="ListBoxItem:pointerover /template/ ContentPresenter">
            <Setter Property="Background" Value="Transparent" />
        </Style>
        <Style Selector="ListBoxItem:selected /template/ ContentPresenter">
            <Setter Property="Background" Value="Transparent" />
        </Style>
        <Style Selector="ListBoxItem:selected:pointerover /template/ ContentPresenter">
            <Setter Property="Background" Value="Transparent" />
        </Style>

        <Style Selector="ListBoxItem:pointerover /template/ Border#ItemBorder">
            <Setter Property="Background" Value="{DynamicResource CardHoverBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource HairlineBrush}" />
        </Style>
        <Style Selector="ListBoxItem:selected /template/ Border#ItemBorder">
            <Setter Property="Background" Value="{DynamicResource CardSelectedBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource HairlineBrush}" />
        </Style>
        <Style Selector="ListBoxItem:selected:pointerover /template/ Border#ItemBorder">
            <Setter Property="Background" Value="{DynamicResource CardSelectedBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource HairlineBrush}" />
        </Style>

        <Style Selector="TextBox#SearchBox">
            <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
            <Setter Property="CaretBrush" Value="{DynamicResource TextPrimaryBrush}" />
            <Setter Property="SelectionBrush" Value="{DynamicResource CardSelectedBrush}" />
            <Setter Property="SelectionForegroundBrush" Value="{DynamicResource TextPrimaryBrush}" />
        </Style>
        <Style Selector="TextBox#SearchBox:pointerover /template/ Border#PART_BorderElement">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
        </Style>
        <Style Selector="TextBox#SearchBox:focus /template/ Border#PART_BorderElement">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
        </Style>
        <Style Selector="TextBox#SearchBox /template/ TextBlock#PART_Watermark">
            <Setter Property="Foreground" Value="{DynamicResource TextTertiaryBrush}" />
            <Setter Property="Opacity" Value="0.85" />
        </Style>

        <!-- Context Menu Styles -->
        <Style Selector="ContextMenu">
            <Setter Property="Background" Value="{DynamicResource FlyoutBackground}" />
            <Setter Property="BorderBrush" Value="{DynamicResource CardBorderBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="8" />
            <Setter Property="Padding" Value="4" />
        </Style>
        <Style Selector="ContextMenu /template/ Border">
            <Setter Property="BoxShadow" Value="0 6 24 #60000000" />
            <Setter Property="CornerRadius" Value="8" />
        </Style>
        <Style Selector="MenuItem">
            <Setter Property="CornerRadius" Value="5" />
            <Setter Property="Padding" Value="10,6" />
            <Setter Property="FontSize" Value="{DynamicResource SubBodyFontSize}" />
            <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
        </Style>
        <Style Selector="MenuItem /template/ Border#PART_LayoutRoot">
            <Setter Property="CornerRadius" Value="5" />
        </Style>
        <Style Selector="MenuItem:pointerover /template/ Border#PART_LayoutRoot">
            <Setter Property="Background" Value="{DynamicResource CardHoverBrush}" />
        </Style>
        <Style Selector="MenuItem /template/ ContentPresenter#PART_HeaderPresenter">
            <Setter Property="Margin" Value="6,0,12,0" />
        </Style>
        <Style Selector="MenuItem /template/ TextBlock#PART_InputGestureText">
            <Setter Property="Foreground" Value="{DynamicResource TextTertiaryBrush}" />
            <Setter Property="FontSize" Value="{DynamicResource CaptionFontSize}" />
        </Style>
        <Style Selector="MenuItem.ShortcutCopy /template/ TextBlock#PART_InputGestureText">
            <Setter Property="IsVisible" Value="True" />
            <Setter Property="Text" Value="{DynamicResource ShortcutCopyText}" />
        </Style>
        <Style Selector="MenuItem.ShortcutEdit /template/ TextBlock#PART_InputGestureText">
            <Setter Property="IsVisible" Value="True" />
            <Setter Property="Text" Value="{DynamicResource ShortcutEditText}" />
        </Style>
        <Style Selector="MenuItem.ShortcutFavorite /template/ TextBlock#PART_InputGestureText">
            <Setter Property="IsVisible" Value="True" />
            <Setter Property="Text" Value="{DynamicResource ShortcutFavoriteText}" />
        </Style>
        <Style Selector="MenuItem.ShortcutDelete /template/ TextBlock#PART_InputGestureText">
            <Setter Property="IsVisible" Value="True" />
            <Setter Property="Text" Value="{DynamicResource ShortcutDeleteText}" />
        </Style>
        <Style Selector="Separator">
            <Setter Property="Background" Value="{DynamicResource DividerBrush}" />
            <Setter Property="Height" Value="1" />
            <Setter Property="Margin" Value="4,3" />
        </Style>

        <!-- Segmented Mode Pill Styles for RichText/PlainText Toggle -->
        <Style Selector="Button.SegmentPill">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="CornerRadius" Value="10" />
            <Setter Property="Padding" Value="10,3" />
            <Setter Property="FontSize" Value="{DynamicResource CaptionFontSize}" />
            <Setter Property="Foreground" Value="{DynamicResource TextTertiaryBrush}" />
            <Setter Property="Cursor" Value="Hand" />
        </Style>
        <Style Selector="Button.SegmentPill:pointerover">
            <Setter Property="Background" Value="{DynamicResource CardHoverBrush}" />
            <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
        </Style>
        <Style Selector="Button.SegmentPill.active">
            <Setter Property="Background" Value="{DynamicResource ActiveChipBackground}" />
            <Setter Property="Foreground" Value="{DynamicResource ActiveChipForeground}" />
            <Setter Property="FontWeight" Value="{DynamicResource TitleFontWeight}" />
        </Style>
        <Style Selector="Button.SegmentPill.active:pointerover">
            <Setter Property="Background" Value="{DynamicResource ActiveChipBackground}" />
            <Setter Property="Foreground" Value="{DynamicResource ActiveChipForeground}" />
        </Style>
    </Window.Styles>

    <Panel>
        <Border Background="{DynamicResource SurfaceBackground}"
                CornerRadius="{DynamicResource WindowCornerRadius}"
                BorderBrush="{DynamicResource WindowBorderBrush}"
                BorderThickness="{DynamicResource WindowBorderThickness}"
                ClipToBounds="True">
            <Grid RowDefinitions="Auto,Auto,Auto,*,Auto">

            <!-- ========== Row 0: Header ========== -->
            <Border x:Name="HeaderBorder" Grid.Row="0" Padding="16,14,14,6" Background="Transparent">
                <Grid ColumnDefinitions="*,Auto,Auto">
                    <TextBlock Grid.Column="0"
                               Text="{Binding L[Panel_Title]}"
                               FontSize="{DynamicResource PageTitleFontSize}"
                               FontWeight="{DynamicResource TitleFontWeight}"
                               Foreground="{DynamicResource TextPrimaryBrush}"
                               VerticalAlignment="Center" />

                    <controls:IconButton Grid.Column="1"
                                         IconKind="Settings"
                                         IconSize="15"
                                         ToolTipText="{Binding L[Settings_Title]}"
                                         Click="OnSettingsClicked"
                                         Margin="0,0,4,0" />

                    <controls:IconButton Grid.Column="2"
                                         IconKind="Close"
                                         IconSize="14"
                                         ToolTipText="{Binding L[Panel_Footer_Close]}"
                                         Click="OnCloseClicked" />
                </Grid>
            </Border>

            <!-- ========== Row 1: Search Bar ========== -->
            <Border Grid.Row="1" Padding="16,4,16,8">
                <Border Background="{DynamicResource SearchBackground}"
                        BorderBrush="{DynamicResource SearchBorderBrush}"
                        BorderThickness="1"
                        CornerRadius="{DynamicResource SearchBoxCornerRadius}"
                        Height="{DynamicResource SearchBoxHeight}">
                    <Grid ColumnDefinitions="Auto,*">
                        <Border Grid.Column="0" Padding="10,0,6,0" VerticalAlignment="Center">
                            <controls:AppIcon Kind="Search" Size="14" Foreground="{DynamicResource TextSecondaryBrush}" />
                        </Border>
                        <TextBox Grid.Column="1"
                                 x:Name="SearchBox"
                                 Text="{Binding SearchText, Mode=TwoWay}"
                                 Watermark="{Binding L[Panel_Search_Placeholder]}"
                                 Background="Transparent"
                                 BorderThickness="0"
                                 Foreground="{DynamicResource TextPrimaryBrush}"
                                 VerticalAlignment="Center"
                                 VerticalContentAlignment="Center"
                                 Padding="0,0,10,0" />
                    </Grid>
                </Border>
            </Border>

            <!-- ========== Row 2: Filter Tabs ========== -->
            <Border Grid.Row="2" Padding="16,2,16,8">
                <controls:UnderlineTabBar x:Name="FilterTabBar"
                                          SelectedValue="{Binding CurrentFilterType, Mode=TwoWay, FallbackValue='All'}">
                    <controls:UnderlineTabItem Content="{Binding L[Category_Favorite], FallbackValue='收藏'}" Value="Favorite" />
                    <controls:UnderlineTabItem Content="{Binding L[Category_All], FallbackValue='全部'}" Value="All" />
                    <controls:UnderlineTabItem Content="{Binding L[Category_Text], FallbackValue='文本'}" Value="Text" />
                    <controls:UnderlineTabItem Content="{Binding L[Category_Image], FallbackValue='图片'}" Value="Image" />
                    <controls:UnderlineTabItem Content="{Binding L[Category_File], FallbackValue='文件'}" Value="File" />
                </controls:UnderlineTabBar>
            </Border>

            <!-- ========== Divider ========== -->
            <Rectangle Grid.Row="2" Height="1" Fill="{DynamicResource DividerBrush}" VerticalAlignment="Bottom" Margin="16,0" />

            <!-- ========== Row 3: Items List & Empty State ========== -->
            <Grid Grid.Row="3">
                <ListBox x:Name="ItemsListBox"
                         ItemsSource="{Binding Items}"
                         SelectedItem="{Binding SelectedItem, Mode=TwoWay}"
                         Background="Transparent"
                         BorderThickness="0"
                         Padding="10,6"
                         DoubleTapped="OnItemDoubleTapped">
                    <ListBox.ItemTemplate>
                        <DataTemplate x:DataType="models:ClipboardItem">
                            <Panel Margin="0" ClipToBounds="True" Background="Transparent" HorizontalAlignment="Stretch" VerticalAlignment="Stretch">
                                <Panel.ContextMenu>
                                    <ContextMenu>
                                        <MenuItem Classes="ShortcutCopy"
                                                  Header="{Binding $parent[Window].((vm:MainViewModel)DataContext).L[Menu_Copy]}"
                                                  InputGesture="Ctrl+C"
                                                  Command="{Binding $parent[Window].((vm:MainViewModel)DataContext).CopyItemToClipboardCommand}"
                                                  CommandParameter="{Binding}">
                                            <MenuItem.Icon>
                                                <controls:AppIcon Kind="Copy" Size="14" Foreground="{DynamicResource TextSecondaryBrush}" />
                                            </MenuItem.Icon>
                                        </MenuItem>
                                        <MenuItem Classes="ShortcutEdit"
                                                  Header="{Binding $parent[Window].((vm:MainViewModel)DataContext).L[Menu_Edit]}"
                                                  InputGesture="Ctrl+E"
                                                  Command="{Binding $parent[Window].((vm:MainViewModel)DataContext).StartEditItemCommand}"
                                                  CommandParameter="{Binding}"
                                                  IsEnabled="{Binding IsText}">
                                            <MenuItem.Icon>
                                                <controls:AppIcon Kind="Edit" Size="14" Foreground="{DynamicResource TextSecondaryBrush}" />
                                            </MenuItem.Icon>
                                        </MenuItem>
                                        <MenuItem Classes="ShortcutFavorite"
                                                  Header="{Binding $parent[Window].((vm:MainViewModel)DataContext).L[Menu_Favorite]}"
                                                  InputGesture="Ctrl+D"
                                                  Command="{Binding $parent[Window].((vm:MainViewModel)DataContext).ToggleFavoriteCommand}"
                                                  CommandParameter="{Binding}">
                                            <MenuItem.Icon>
                                                <controls:AppIcon Kind="Star" Size="14" Foreground="{DynamicResource TextSecondaryBrush}" />
                                            </MenuItem.Icon>
                                        </MenuItem>
                                        <Separator />
                                        <MenuItem Classes="ShortcutDelete"
                                                  Header="{Binding $parent[Window].((vm:MainViewModel)DataContext).L[Menu_Delete]}"
                                                  InputGesture="Ctrl+Back"
                                                  Foreground="{DynamicResource EmberBrush}"
                                                  Command="{Binding $parent[Window].((vm:MainViewModel)DataContext).DeleteItemCommand}"
                                                  CommandParameter="{Binding}">
                                            <MenuItem.Icon>
                                                <controls:AppIcon Kind="Delete" Size="14" Foreground="{DynamicResource EmberBrush}" />
                                            </MenuItem.Icon>
                                        </MenuItem>
                                    </ContextMenu>
                                </Panel.ContextMenu>

                                <!-- Left Accent Selection Indicator (DESIGN.md section 2.1) -->
                                <Border Width="3"
                                        Height="32"
                                        CornerRadius="1.5"
                                        Background="{DynamicResource AccentBrush}"
                                        HorizontalAlignment="Left"
                                        VerticalAlignment="Center"
                                        Margin="4,0,0,0"
                                        IsVisible="{Binding $parent[ListBoxItem].IsSelected}" />

                                <Grid Margin="12,8,10,8" ColumnDefinitions="*,Auto">
                                    <!-- Main Info -->
                                    <Grid Grid.Column="0" RowDefinitions="*,Auto" VerticalAlignment="Stretch">
                                        <!-- Top Content Area (Top-Aligned) -->
                                        <StackPanel Grid.Row="0" Spacing="6" VerticalAlignment="Top">
                                            <!-- File Display -->
                                            <StackPanel IsVisible="{Binding IsFile}" Spacing="2" VerticalAlignment="Top">
                                                <TextBlock Text="{Binding FileDisplayName}"
                                                           FontSize="{DynamicResource BodyFontSize}"
                                                           FontWeight="{DynamicResource BodyFontWeight}"
                                                           Foreground="{DynamicResource TextPrimaryBrush}"
                                                           TextTrimming="CharacterEllipsis" />
                                                <TextBlock Text="{Binding FilePathDisplay}"
                                                           FontSize="{DynamicResource CaptionFontSize}"
                                                           Foreground="{DynamicResource TextTertiaryBrush}"
                                                           TextTrimming="CharacterEllipsis"
                                                           MaxLines="2" />
                                            </StackPanel>

                                            <!-- Image Display -->
                                            <Border IsVisible="{Binding HasImagePreview}"
                                                    CornerRadius="4"
                                                    ClipToBounds="True"
                                                    Background="{DynamicResource SearchBackground}"
                                                    BorderBrush="{DynamicResource SearchBorderBrush}"
                                                    BorderThickness="1"
                                                    HorizontalAlignment="Left"
                                                    MaxHeight="120">
                                                <Image Source="{Binding EffectiveImagePath, Converter={StaticResource ImagePathToBitmapConverter}}"
                                                       MaxWidth="180"
                                                       MaxHeight="120"
                                                       Stretch="Uniform" />
                                            </Border>

                                            <!-- Text Display -->
                                            <Grid ColumnDefinitions="Auto,*" IsVisible="{Binding IsText}" VerticalAlignment="Top">
                                                <!-- Hex Color Swatch -->
                                                <Border Grid.Column="0"
                                                        IsVisible="{Binding Text, Converter={StaticResource HexColorVisibilityConverter}}"
                                                        Width="18" Height="18"
                                                        CornerRadius="3"
                                                        Margin="0,1,8,0"
                                                        Background="{Binding Text, Converter={StaticResource HexColorToBrushConverter}}"
                                                        BorderBrush="{DynamicResource DividerBrush}"
                                                        BorderThickness="1"
                                                        VerticalAlignment="Top" />

                                                <!-- Text Preview -->
                                                <TextBlock Grid.Column="1"
                                                           Text="{Binding Preview}"
                                                           FontSize="{DynamicResource BodyFontSize}"
                                                           FontWeight="{DynamicResource BodyFontWeight}"
                                                           Foreground="{DynamicResource TextPrimaryBrush}"
                                                           TextWrapping="Wrap"
                                                           MaxLines="3"
                                                           TextTrimming="CharacterEllipsis"
                                                           VerticalAlignment="Top" />
                                            </Grid>
                                        </StackPanel>

                                        <!-- Metadata line (Bottom-Aligned Time & Pin) -->
                                        <StackPanel Grid.Row="1"
                                                    Orientation="Horizontal"
                                                    Spacing="6"
                                                    VerticalAlignment="Bottom"
                                                    Margin="0,6,0,0">
                                            <!-- Favorite indicator -->
                                            <Border IsVisible="{Binding IsFavorite}" VerticalAlignment="Center">
                                                 <controls:AppIcon Kind="Star" Size="11" Foreground="{DynamicResource InkBrush}" />
                                            </Border>
                                            <TextBlock Text="{Binding ImageSizeDisplay}"
                                                       FontSize="{DynamicResource CaptionFontSize}"
                                                       Foreground="{DynamicResource TextTertiaryBrush}"
                                                       VerticalAlignment="Center"
                                                       IsVisible="{Binding IsImage}" />
                                            <TextBlock Text="{Binding CopiedAtDisplay}"
                                                       FontSize="{DynamicResource CaptionFontSize}"
                                                       Foreground="{DynamicResource TextTertiaryBrush}"
                                                       VerticalAlignment="Center" />
                                        </StackPanel>
                                    </Grid>

                                    <!-- Quick Action Buttons -->
                                    <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="4" Margin="8,0,0,0">
                                        <controls:IconButton IconKind="Star"
                                                             IconSize="13"
                                                             ToolTipText="{Binding $parent[Window].((vm:MainViewModel)DataContext).L[Menu_Favorite]}"
                                                             IsActive="{Binding IsFavorite}"
                                                             Command="{Binding $parent[Window].((vm:MainViewModel)DataContext).ToggleFavoriteCommand}"
                                                             CommandParameter="{Binding}" />
                                        <controls:IconButton IconKind="Delete"
                                                             IconSize="13"
                                                             ToolTipText="{Binding $parent[Window].((vm:MainViewModel)DataContext).L[Menu_Delete]}"
                                                             HoverForeground="{DynamicResource EmberBrush}"
                                                             HoverBackground="#1AE7000B"
                                                             Command="{Binding $parent[Window].((vm:MainViewModel)DataContext).DeleteItemCommand}"
                                                             CommandParameter="{Binding}" />
                                    </StackPanel>
                                </Grid>
                            </Panel>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>

                <!-- Empty state when no items -->
                <Border IsVisible="{Binding !Items.Count}"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center">
                    <StackPanel Spacing="10" HorizontalAlignment="Center">
                        <Border Background="{DynamicResource CardBackground}"
                                BorderBrush="{DynamicResource CardBorderBrush}"
                                BorderThickness="1"
                                CornerRadius="32" Width="64" Height="64"
                                HorizontalAlignment="Center">
                            <controls:AppIcon Kind="{Binding EmptyIconKind}" Size="32" Foreground="{DynamicResource TextTertiaryBrush}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <TextBlock Text="{Binding EmptyTitleDisplay}"
                                   FontSize="{DynamicResource SectionTitleFontSize}"
                                   FontWeight="{DynamicResource BodyFontWeight}"
                                   Foreground="{DynamicResource TextSecondaryBrush}"
                                   HorizontalAlignment="Center" />
                        <TextBlock Text="{Binding EmptyHintDisplay}"
                                   FontSize="{DynamicResource SubBodyFontSize}"
                                   Foreground="{DynamicResource TextTertiaryBrush}"
                                   HorizontalAlignment="Center" />
                    </StackPanel>
                </Border>
            </Grid>

            <!-- ========== Row 4: Footer Key Hints ========== -->
            <Border Grid.Row="4"
                    Background="{DynamicResource FooterBackground}"
                    BorderBrush="{DynamicResource HairlineBrush}"
                    BorderThickness="0,1,0,0"
                    Padding="16,8">
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Spacing="10">
                    <StackPanel Orientation="Horizontal" Spacing="4" VerticalAlignment="Center">
                        <Border Background="{DynamicResource KeyHintBackground}"
                                BorderBrush="{DynamicResource KeyHintBorderBrush}"
                                BorderThickness="1"
                                CornerRadius="{DynamicResource KeyHintCornerRadius}"
                                Padding="6,2">
                            <TextBlock x:Name="CategoryKeyHint" Text="← →" FontSize="{DynamicResource CaptionFontSize}" Foreground="{DynamicResource TextPrimaryBrush}" />
                        </Border>
                        <TextBlock Text="{Binding L[Panel_Footer_Category]}" FontSize="{DynamicResource CaptionFontSize}" Foreground="{DynamicResource TextSecondaryBrush}" VerticalAlignment="Center" />
                    </StackPanel>

                    <StackPanel Orientation="Horizontal" Spacing="4" VerticalAlignment="Center">
                        <Border Background="{DynamicResource KeyHintBackground}"
                                BorderBrush="{DynamicResource KeyHintBorderBrush}"
                                BorderThickness="1"
                                CornerRadius="{DynamicResource KeyHintCornerRadius}"
                                Padding="6,2">
                            <TextBlock x:Name="NavigateKeyHint" Text="↑ ↓" FontSize="{DynamicResource CaptionFontSize}" Foreground="{DynamicResource TextPrimaryBrush}" />
                        </Border>
                        <TextBlock Text="{Binding L[Panel_Footer_Nav]}" FontSize="{DynamicResource CaptionFontSize}" Foreground="{DynamicResource TextSecondaryBrush}" VerticalAlignment="Center" />
                    </StackPanel>

                    <StackPanel Orientation="Horizontal" Spacing="4" VerticalAlignment="Center">
                        <Border Background="{DynamicResource KeyHintBackground}"
                                BorderBrush="{DynamicResource KeyHintBorderBrush}"
                                BorderThickness="1"
                                CornerRadius="{DynamicResource KeyHintCornerRadius}"
                                Padding="6,2">
                            <TextBlock x:Name="PasteKeyHint" Text="Enter" FontSize="{DynamicResource CaptionFontSize}" Foreground="{DynamicResource TextPrimaryBrush}" />
                        </Border>
                        <TextBlock Text="{Binding L[Panel_Footer_Paste]}" FontSize="{DynamicResource CaptionFontSize}" Foreground="{DynamicResource TextSecondaryBrush}" VerticalAlignment="Center" />
                    </StackPanel>

                    <StackPanel Orientation="Horizontal" Spacing="4" VerticalAlignment="Center">
                        <Border Background="{DynamicResource KeyHintBackground}"
                                BorderBrush="{DynamicResource KeyHintBorderBrush}"
                                BorderThickness="1"
                                CornerRadius="{DynamicResource KeyHintCornerRadius}"
                                Padding="6,2">
                            <TextBlock x:Name="CloseKeyHint" Text="Esc" FontSize="{DynamicResource CaptionFontSize}" Foreground="{DynamicResource TextPrimaryBrush}" />
                        </Border>
                        <TextBlock Text="{Binding L[Panel_Footer_Close]}" FontSize="{DynamicResource CaptionFontSize}" Foreground="{DynamicResource TextSecondaryBrush}" VerticalAlignment="Center" />
                    </StackPanel>
                </StackPanel>
            </Border>

            <!-- ========== Item Editor Overlay Modal ========== -->
            <Border x:Name="EditorOverlay"
                    Grid.Row="0" Grid.RowSpan="5"
                    ZIndex="100"
                    Background="#8A000000"
                    IsVisible="{Binding IsEditingItem, FallbackValue=False}"
                    IsHitTestVisible="{Binding IsEditingItem, FallbackValue=False}"
                    PointerPressed="OnOverlayBackdropPointerPressed">
                <Grid Margin="20" VerticalAlignment="Center">
                    <Border Background="{DynamicResource CardBackground}"
                            BorderBrush="{DynamicResource WindowBorderBrush}"
                            BorderThickness="1"
                            CornerRadius="{DynamicResource ItemCardCornerRadius}"
                            BoxShadow="0 8 32 #70000000"
                            Padding="16">
                        <Grid RowDefinitions="Auto,*,Auto">
                            <!-- Overlay Header -->
                            <Grid Grid.Row="0" ColumnDefinitions="Auto,*,Auto,Auto" Margin="0,0,0,12" VerticalAlignment="Center">
                                <TextBlock Grid.Column="0"
                                           Text="{Binding L[Editor_Title]}"
                                           FontSize="{DynamicResource SectionTitleFontSize}"
                                           FontWeight="{DynamicResource TitleFontWeight}"
                                           Foreground="{DynamicResource TextPrimaryBrush}"
                                           VerticalAlignment="Center" />

                                <!-- Dual Mode Toggle Pill (Visible when item has rich text) -->
                                <Border Grid.Column="2"
                                        Background="{DynamicResource KeyHintBackground}"
                                        BorderBrush="{DynamicResource KeyHintBorderBrush}"
                                        BorderThickness="1"
                                        CornerRadius="12"
                                        Padding="2"
                                        Margin="0,0,10,0"
                                        IsVisible="{Binding HasRichText}"
                                        VerticalAlignment="Center">
                                    <StackPanel Orientation="Horizontal" Spacing="2">
                                        <Button Classes="SegmentPill"
                                                Classes.active="{Binding IsRichTextMode}"
                                                Content="HTML"
                                                Command="{Binding SwitchEditModeCommand}"
                                                CommandParameter="{x:True}" />
                                        <Button Classes="SegmentPill"
                                                Classes.active="{Binding !IsRichTextMode}"
                                                Content="{Binding L[Editor_PlainText]}"
                                                Command="{Binding SwitchEditModeCommand}"
                                                CommandParameter="{x:False}" />
                                    </StackPanel>
                                </Border>

                                <!-- Close Button -->
                                <controls:IconButton Grid.Column="3"
                                                     IconKind="Close"
                                                     IconSize="13"
                                                     ToolTip.Tip="{DynamicResource ShortcutCancelTooltip}"
                                                     Command="{Binding CancelEditItemCommand}" />
                            </Grid>

                            <!-- Text Editor Content Area -->
                            <Border Grid.Row="1"
                                    Background="{DynamicResource SearchBackground}"
                                    BorderBrush="{DynamicResource SearchBorderBrush}"
                                    BorderThickness="1"
                                    CornerRadius="6"
                                    Padding="8"
                                    MinHeight="200"
                                    MaxHeight="340">
                                <TextBox x:Name="EditItemTextBox"
                                         Text="{Binding EditingText, Mode=TwoWay}"
                                         AcceptsReturn="True"
                                         AcceptsTab="True"
                                         TextWrapping="Wrap"
                                         Background="Transparent"
                                         BorderThickness="0"
                                         Foreground="{DynamicResource TextPrimaryBrush}"
                                         CaretBrush="{DynamicResource TextPrimaryBrush}"
                                         FontSize="{DynamicResource BodyFontSize}"
                                         FontFamily="{DynamicResource PrimaryFontFamily}"
                                         ScrollViewer.VerticalScrollBarVisibility="Auto"
                                         ScrollViewer.HorizontalScrollBarVisibility="Disabled" />
                            </Border>

                            <!-- Overlay Footer -->
                            <Grid Grid.Row="2" ColumnDefinitions="Auto,*,Auto,Auto" Margin="0,12,0,0" VerticalAlignment="Center">
                                <!-- Word / Char Count Display -->
                                <TextBlock Grid.Column="0"
                                           Text="{Binding CharCountDisplay}"
                                           FontSize="{DynamicResource CaptionFontSize}"
                                           Foreground="{DynamicResource TextTertiaryBrush}"
                                           VerticalAlignment="Center" />

                                <!-- Action Buttons -->
                                <Button Grid.Column="2"
                                        Content="{Binding L[Editor_Cancel]}"
                                        ToolTip.Tip="{DynamicResource ShortcutCancelTooltip}"
                                        Margin="0,0,8,0"
                                        Padding="14,6"
                                        CornerRadius="6"
                                        FontSize="{DynamicResource SubBodyFontSize}"
                                        Background="Transparent"
                                        BorderBrush="{DynamicResource HairlineBrush}"
                                        BorderThickness="1"
                                        Foreground="{DynamicResource TextSecondaryBrush}"
                                        Command="{Binding CancelEditItemCommand}" />

                                <Button Grid.Column="3"
                                        Content="{Binding L[Editor_Save]}"
                                        ToolTip.Tip="{DynamicResource ShortcutSaveTooltip}"
                                        Padding="14,6"
                                        CornerRadius="6"
                                        FontSize="{DynamicResource SubBodyFontSize}"
                                        FontWeight="{DynamicResource TitleFontWeight}"
                                        Background="{DynamicResource AccentBrush}"
                                        Foreground="{DynamicResource ActiveChipForeground}"
                                        BorderThickness="0"
                                        Command="{Binding SaveEditItemCommand}" />
                            </Grid>
                        </Grid>
                    </Border>
                </Grid>
            </Border>

        </Grid>
    </Border>
    </Panel>
</Window>
