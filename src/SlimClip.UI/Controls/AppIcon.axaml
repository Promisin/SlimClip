<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d" d:DesignWidth="24" d:DesignHeight="24"
             x:Class="SlimClip.UI.Controls.AppIcon"
             Width="{Binding $self.Size}"
             Height="{Binding $self.Size}">
    <Viewbox Width="{Binding $self.Size}"
             Height="{Binding $self.Size}"
             HorizontalAlignment="Center"
             VerticalAlignment="Center"
             Stretch="Uniform">
        <Canvas Width="24" Height="24" ClipToBounds="False">
            <Path x:Name="IconPath"
                  Fill="{Binding $parent[UserControl].Foreground}"
                  StrokeThickness="0" />
        </Canvas>
    </Viewbox>
</UserControl>
