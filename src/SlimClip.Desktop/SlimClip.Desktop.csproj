<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <AssemblyName>SlimClip</AssemblyName>
    <TargetFramework Condition="$([MSBuild]::IsOSPlatform('Windows'))">net10.0-windows10.0.22621.0</TargetFramework>
    <TargetFramework Condition="!$([MSBuild]::IsOSPlatform('Windows'))">net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <LangVersion>13</LangVersion>
    <NoWarn>$(NoWarn);NU1903</NoWarn>
    <ApplicationIcon>Assets\app.ico</ApplicationIcon>

    <!-- macOS App Bundle Properties (dotnet-bundle) -->
    <CFBundleName>SlimClip</CFBundleName>
    <CFBundleDisplayName>SlimClip</CFBundleDisplayName>
    <CFBundleIdentifier>com.promisin.slimclip</CFBundleIdentifier>
    <CFBundleVersion>$(Version)</CFBundleVersion>
    <CFBundleShortVersionString>$(Version)</CFBundleShortVersionString>
    <CFBundlePackageType>APPL</CFBundlePackageType>
    <CFBundleExecutable>SlimClip</CFBundleExecutable>
    <CFBundleIconFile>app.icns</CFBundleIconFile>
    <LSUIElement>true</LSUIElement>
    <NSHighResolutionCapable>true</NSHighResolutionCapable>
  </PropertyGroup>

  <PropertyGroup Condition="$([MSBuild]::IsOSPlatform('Windows'))">
    <ApplicationManifest>app.manifest</ApplicationManifest>
  </PropertyGroup>

  <ItemGroup>
    <AvaloniaResource Include="Assets\**" />
    <Content Include="Assets\**">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <CopyToPublishDirectory>PreserveNewest</CopyToPublishDirectory>
    </Content>
    <InternalsVisibleTo Include="SlimClip.Tests" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Avalonia.Desktop" Version="12.1.4" />
    <PackageReference Include="Avalonia.Themes.Fluent" Version="12.1.4" />
    <PackageReference Include="Avalonia.Fonts.Inter" Version="12.1.4" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\SlimClip.Core\SlimClip.Core.csproj" />
    <ProjectReference Include="..\SlimClip.UI\SlimClip.UI.csproj" />
    <ProjectReference Include="..\SlimClip.Platform.MacOS\SlimClip.Platform.MacOS.csproj" />
  </ItemGroup>

  <ItemGroup Condition="$([MSBuild]::IsOSPlatform('Windows'))">
    <ProjectReference Include="..\SlimClip.Platform.Windows\SlimClip.Platform.Windows.csproj" />
  </ItemGroup>

</Project>
